# ════════════════════════════════════════════════════════
# TalkingHeadAI — Environment Variables
# Copy this file to .env and fill in your values
# ════════════════════════════════════════════════════════

# ── Provider Selection ────────────────────────────────
# Change these to switch between cloud and local providers
LLM_PROVIDER=claude           # claude | ollama
STT_PROVIDER=deepgram         # deepgram | whisper
TTS_PROVIDER=elevenlabs       # elevenlabs | coqui
AVATAR_PROVIDER=did           # did | sadtalker
EMBEDDING_PROVIDER=openai     # openai | local

# ── Cloud API Keys ────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE
OPENAI_API_KEY=sk-YOUR_KEY_HERE
DEEPGRAM_API_KEY=YOUR_DEEPGRAM_KEY
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_KEY
ELEVENLABS_VOICE_ID=YOUR_VOICE_ID
DID_API_KEY=YOUR_DID_API_KEY
DID_AVATAR_IMAGE_URL=https://your-cdn/avatar-photo.jpg

# ── Database ──────────────────────────────────────────
POSTGRES_DB=talkinghead
POSTGRES_USER=thuser
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION
DATABASE_URL=postgresql+asyncpg://thuser:CHANGE_ME_IN_PRODUCTION@postgres:5432/talkinghead
QDRANT_URL=http://qdrant:6333
REDIS_URL=redis://redis:6379

# ── Application ───────────────────────────────────────
SIMILARITY_THRESHOLD=0.85
RAG_TOP_K=5
LLM_MAX_TOKENS=300
EMBEDDING_DIM=1536            # 1536 for openai, 768 for local
API_KEY=CHANGE_ME_IN_PRODUCTION

# ── Local AI Service URLs ─────────────────────────────
# (used when STT_PROVIDER=whisper, TTS_PROVIDER=coqui, etc.)
WHISPER_URL=http://whisper:8001
WHISPER_MODEL=base            # tiny | base | small | medium | large-v3
WHISPER_DEVICE=cpu            # cpu | cuda
WHISPER_COMPUTE_TYPE=int8

COQUI_TTS_URL=http://coqui-tts:8002
TTS_MODEL=tts_models/multilingual/multi-dataset/xtts_v2
TTS_DEVICE=cpu                # cpu | cuda
SPEAKER_WAV_URL=              # Path to mentor voice sample WAV (for voice cloning)

SADTALKER_URL=http://sadtalker:8003
SADTALKER_DEVICE=cpu          # cpu | cuda
SADTALKER_STILL=true          # true = less head motion (more realistic for static avatar)
SADTALKER_ENHANCER=gfpgan    # gfpgan | RestoreFormer (face enhancement)

OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b      # llama3.2:3b | llama3.1:8b | mistral:7b

# ── Ports & Paths ─────────────────────────────────────
HTTP_PORT=80
AVATAR_OUTPUT_DIR=./data/avatars

# ── Frontend URLs (exposed to browser) ───────────────
# For Docker/nginx (production):
# NEXT_PUBLIC_WS_URL=ws://localhost/ws
# NEXT_PUBLIC_API_URL=http://localhost/api
# For local dev (backend on port 8009):
NEXT_PUBLIC_WS_URL=ws://localhost:8009/api/ws
NEXT_PUBLIC_API_URL=http://localhost:8009/api
NEXT_PUBLIC_API_KEY=CHANGE_ME_IN_PRODUCTION
